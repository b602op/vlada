{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Property Configuration",
  "description": "Конфигурация объекта недвижимости",
  "type": "object",
  "required": ["property", "agent"],
  "properties": {
    "property": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["apartment", "house", "commercial", "land"],
          "description": "Тип недвижимости"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Название/заголовок объекта"
        },
        "price": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Цена (null если не указана)"
        },
        "currency": {
          "type": "string",
          "enum": ["RUB", "USD", "EUR"],
          "description": "Валюта цены"
        },
        "rooms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Количество комнат (null если не указано)"
        },
        "area": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Площадь в м² (null если не указано)"
        },
        "floor": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Этаж (null если не указано)"
        },
        "totalFloors": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Общая этажность здания (null если не указано)"
        },
        "address": {
          "type": "string",
          "description": "Адрес объекта"
        },
        "description": {
          "type": "string",
          "description": "Описание объекта"
        },
        "features": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Особенности объекта"
        },
        "characteristics": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "string"
          },
          "description": "Дополнительные характеристики в формате ключ: значение"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["name", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 },
        "whatsapp": { "type": ["string", "null"] },
        "telegram": { "type": ["string", "null"] },
        "photo": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "complex": {
      "type": ["object", "null"],
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "developer": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "features": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["property"],
      "properties": {
        "property": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "alt"],
            "properties": {
              "file": { "type": "string" },
              "alt": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "alt"],
            "properties": {
              "file": { "type": "string" },
              "alt": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "agent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "alt"],
            "properties": {
              "file": { "type": "string" },
              "alt": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
